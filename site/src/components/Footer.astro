---
import type { Lang } from '@shared/constants';
import NewsletterForm from '../islands/forms/NewsletterForm';
import { pick, useT } from '../i18n';
import { href } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const explore = [
  ['/books/', t('nav.books')],
  ['/news/', t('nav.news')],
  ['/blog/', t('nav.blog')],
  ['/events/', t('nav.events')],
  ['/press-kit/', t('nav.pressKit')],
  ['/bulk-orders/', t('nav.bulk')],
];
const info = [
  ['/faq/', t('nav.faq')],
  ['/track/', t('nav.track')],
  ['/contact/', t('nav.contact')],
  ['/terms/', t('footer.terms')],
  ['/privacy/', t('footer.privacy')],
];
import SocialIcon from './SocialIcon.astro';
---

<footer class="site-footer relative mt-24 overflow-hidden bg-night text-paper">
  <div class="footer-map pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative container-page grid gap-10 py-14 lg:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="font-serif text-3xl font-semibold text-paper">{t('site.name')}</p>
      <p class="mt-1 eyebrow text-gold-light">{t('site.tagline')}</p>
      <p class="mt-4 max-w-prose text-paper/80">{t('footer.about')}</p>
      <ul class="mt-5 flex items-center gap-3" aria-label={t('footer.social')}>
        <li data-config-wrap hidden>
          <a
            href="#"
            data-config="facebook"
            hidden
            class="social-btn"
            rel="noopener"
            target="_blank"
            aria-label={t('footer.facebook')}
            title={t('footer.facebook')}
          >
            <SocialIcon name="facebook" />
          </a>
        </li>
        <li data-config-wrap hidden>
          <a
            href="#"
            data-config="tiktok"
            hidden
            class="social-btn"
            rel="noopener"
            target="_blank"
            aria-label={t('footer.tiktok')}
            title={t('footer.tiktok')}
          >
            <SocialIcon name="tiktok" />
          </a>
        </li>
      </ul>
      <slot />
      <div class="mt-8 rounded-2xl bg-paper p-5 text-ink shadow-xl">
        <p class="font-serif text-2xl font-semibold">{t('home.newsletter.title')}</p>
        <p class="mt-1 text-sm text-ink-soft">{t('footer.newsletter')}</p>
        <div class="mt-3">
          <NewsletterForm
            client:visible
            lang={lang}
            dict={pick(lang, ['newsletter.', 'form.'])}
            source="footer"
          />
        </div>
      </div>
    </div>
    <nav aria-label={t('footer.links')}>
      <h2 class="eyebrow font-sans text-gold-light">{t('footer.links')}</h2>
      <ul class="mt-4 space-y-2">
        {explore.map(([p, l]) => (
          <li>
            <a href={href(lang, p)}>{l}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t('footer.legal')}>
      <h2 class="eyebrow font-sans text-gold-light">{t('footer.legal')}</h2>
      <ul class="mt-4 space-y-2">
        {info.map(([p, l]) => (
          <li>
            <a href={href(lang, p)}>{l}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="relative border-t border-paper/15">
    <p class="container-page py-5 text-sm text-paper/70">
      © {year} {t('site.name')}. {t('footer.rights')}
    </p>
  </div>
</footer>

<style>
  .site-footer a {
    color: var(--color-paper);
    text-decoration-color: rgb(241 232 214 / 0.35);
  }
  .site-footer a:hover {
    color: var(--color-gold-light);
    text-decoration-color: currentColor;
  }
  .site-footer .rounded-2xl a {
    color: var(--color-maroon);
  }
  .site-footer :focus-visible {
    outline-color: var(--color-gold-light);
  }
  .site-footer .rounded-2xl :focus-visible {
    outline-color: var(--color-teal);
  }
  .footer-map {
    background: url('../assets/map-bg.svg') no-repeat right -80px center / 520px auto;
    opacity: 0.08;
    filter: invert(1);
  }
</style>

<style>
  .social-btn {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    color: var(--color-paper);
    text-decoration: none;
  }
  .social-btn:hover,
  .social-btn:focus-visible {
    background: var(--color-paper);
    color: var(--color-night);
  }
</style>
